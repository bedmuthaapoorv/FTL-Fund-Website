# Copy to .env and fill in. Never commit .env.
ENV=dev
DATABASE_URL=sqlite:///./dev.db
SITE_URL=http://localhost:5180

# Encrypts TOTP secrets at rest. Generate:
#   .venv/bin/python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=

# Shared secret for the FrontierTradeLight sync push. Generate:
#   .venv/bin/python -c "import secrets; print(secrets.token_urlsafe(48))"
SYNC_SECRET=

# Contact form: "console" prints locally; "smtp" sends.
EMAIL_BACKEND=console
CONTACT_TO=bedmuthaapoorv@gmail.com
MAIL_FROM=bedmuthaapoorv@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
# For Gmail, use an App Password (Google Account > Security > App passwords).
SMTP_PASSWORD=
